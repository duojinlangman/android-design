<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- 主色：青绿系 -->
    <color name="brand">#0F766E</color>
    <color name="brand_dark">#0B4F4A</color>
    <color name="brand_light">#CCFBF1</color>
    <color name="brand_mid">#14B8A6</color>

    <!-- 强调色：accent 用于色块/图表，accent_text 专用于文字（对比度更高） -->
    <color name="accent">#F59E0B</color>
    <color name="accent_text">#B45309</color>
    <color name="accent_light">#FEF3C7</color>

    <!-- 背景与文字：提高对比度，正文近黑、说明文字加重 -->
    <color name="bg">#EFF6F4</color>
    <color name="surface">#FFFFFFFF</color>
    <color name="text_primary">#0A1C18</color>
    <color name="text_secondary">#3F5954</color>
    <color name="text_tertiary">#627C76</color>
    <!-- 学习卡片上的主文字统一用纯黑，保证在浅色卡片上最清晰 -->
    <color name="text_black">#FF000000</color>
    <color name="divider">#D6E4E0</color>
    <color name="card_stroke">#DEEAE7</color>
    <!-- 配图卡片底色：极浅青，让白底图片有边界又不抢眼 -->
    <color name="surface_soft">#F7FBFA</color>

    <!-- 状态色 -->
    <color name="success">#16A34A</color>
    <color name="success_light">#DCFCE7</color>
    <color name="warning">#F59E0B</color>
    <color name="warning_light">#FEF3C7</color>
    <color name="danger">#DC2626</color>
    <color name="danger_light">#FEE2E2</color>
    <color name="info">#2563EB</color>
</resources>
